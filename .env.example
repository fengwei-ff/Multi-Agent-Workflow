# OpenAI-compatible LLM
# Leave empty to use the built-in Mock LLM.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
USE_MOCK_LLM=false

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Checkpointer (SQLite path for local dev)
CHECKPOINT_DB_PATH=./.data/checkpoints.db
CHECKPOINT_ALLOW_MEMORY_FALLBACK=false
GRAPH_CACHE_SIZE=128

# Agent limits
MAX_DISCUSSION_ROUNDS=8
MAX_REVISION_ROUNDS=5
AGENT_MAX_STEPS=30
AGENT_COMMAND_TIMEOUT=120
AGENT_COMMAND_OUTPUT_LIMIT=200000
AGENT_SHELL_ENABLED=true
AGENT_HTTP_ENABLED=false

# Frontend
VITE_API_BASE_URL=http://localhost:8000
